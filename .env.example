# Copy to .env and adjust. Never commit a real .env — it is in .gitignore.
# Every value below is a non-secret default; the only secret-shaped setting is
# ATLASRAG_LLM_API_KEY, which is optional and unused by the default extractive provider.

# Where the SQLite registry and derived indexes live.
ATLASRAG_DATA_DIR=var

# Ingestion limits.
ATLASRAG_MAX_DOCUMENT_BYTES=5000000

# Deterministic chunking. Changing these changes every chunk id.
ATLASRAG_CHUNK_SIZE_CHARS=1200
ATLASRAG_CHUNK_OVERLAP_CHARS=200

# BM25 parameters.
ATLASRAG_BM25_K1=1.5
ATLASRAG_BM25_B=0.75

# Embedding model, pinned to an exact revision.
ATLASRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ATLASRAG_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
ATLASRAG_EMBEDDING_BATCH_SIZE=8

# Reciprocal Rank Fusion constant.
ATLASRAG_RRF_K=60

# Abstention thresholds. See EVALUATION.md before changing these.
ATLASRAG_ABSTAIN_MIN_SUPPORT=0.35
ATLASRAG_ABSTAIN_MIN_BM25_SCORE=0.5
ATLASRAG_ABSTAIN_MIN_COSINE=0.55
ATLASRAG_EVIDENCE_TOP_N=5

# Answer provider: "extractive" (default, no network) or "llm".
ATLASRAG_ANSWER_PROVIDER=extractive
# ATLASRAG_LLM_BASE_URL=
# ATLASRAG_LLM_MODEL=
# ATLASRAG_LLM_API_KEY=
